# Local (Docker Compose PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentaleasy?schema=public"

# Production (VPS) example — set on the server only, never commit real secrets:
# DATABASE_URL="postgresql://houseasy:PASSWORD@127.0.0.1:5432/houseasy?schema=public"

# Secret used to sign login session cookies/tokens. Generate a long random string in production.
JWT_SECRET="your-secret-key-change-in-production"

# Set to "true" when the site is served over HTTPS (required for login cookies on https://houseasy.io).
COOKIE_SECURE="true"

# Shared secret with PropertySearching so rental admin can read listing counts and trigger sync.
SEARCH_ADMIN_TOKEN="change-me-search-admin-token"
# PropertySearching origin (production: 127.0.0.1:3001; local search usually PORT=3001).
SEARCH_API_URL="http://127.0.0.1:3001"
